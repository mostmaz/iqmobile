{
  "expo": {
    "name": "IQ Admin",
    "slug": "iqmobile-admin",
    "version": "1.1.3",
    "orientation": "portrait",
    "scheme": "iqadmin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "org.iqmobile.admin",
      "versionCode": 3,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D9583A"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.iqmobile.org",
      "apiBaseUrlDev": "http://10.0.2.2:4000",
      "eas": {
        "projectId": "332fd483-d2f2-49ea-8aac-d92dc1b1509b"
      }
    },
    "owner": "mostmaz73"
  }
}