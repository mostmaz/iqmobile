{
  "expo": {
    "name": "IQ Admin",
    "slug": "iqmobile-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "iqadmin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "org.iqmobile.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B1A18"
      },
      "permissions": ["POST_NOTIFICATIONS"],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D9583A"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.iqmobile.org",
      "apiBaseUrlDev": "http://10.0.2.2:4000"
    }
  }
}
