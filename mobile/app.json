      "sentryDsn": "https://f1a835e5f015a4d0f6dc0948a1239a69@o4511382795059200.ingest.de.sentry.io/4511382804955216",
      "posthogKey": "",
      "posthogHost": "https://eu.i.posthog.com",
      "eas": {
        "projectId": "ed963d5c-2d36-4ed9-a907-4cad444d4d59"
