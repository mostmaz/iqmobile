PORT=4001
JWT_SECRET=change-me-in-prod
JWT_TTL=7d
DB_PATH=./data/iqmobile2.db
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin
REQUEST_TTL_MIN=10
INQUIRY_TTL_MIN=30
DAILY_THRESHOLD=50
RESTRICTED_BRAND_CAP=3

# ─── Phone verification over WhatsApp (ARQAM) ────────────────────────
# A key alone changes nothing; verification starts only when
# OTP_REQUIRED=true, so the key can be deployed and checked first.
ARQAM_API_KEY=
# Optional. Defaults to https://otp.arqam.tech/api
ARQAM_BASE_URL=
# Optional. Meta-approved template key; defaults to 'otp'
ARQAM_TEMPLATE=
OTP_REQUIRED=false
