PORT=4001
JWT_SECRET=change-me-in-prod
JWT_TTL=7d
DB_PATH=./data/iqmobile2.db
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin
REQUEST_TTL_MIN=10
INQUIRY_TTL_MIN=30
DAILY_THRESHOLD=50
RESTRICTED_BRAND_CAP=3

# ─── Phone verification over WhatsApp (ARQAM) ────────────────────────
# A key alone changes nothing; verification starts only when
# OTP_REQUIRED=true, so the key can be deployed and checked first.
ARQAM_API_KEY=
# Optional. Defaults to https://otp.arqam.tech/api
ARQAM_BASE_URL=
# Optional. Meta-approved template key; defaults to 'otp'
ARQAM_TEMPLATE=
OTP_REQUIRED=false
# Store reviewers' demo sign-in (src/reviewLogin.js). This one number takes
# this fixed six-digit code and is never sent a message. Put both in the App
# Review notes. Use an unallocated 073… number so no real person owns it.
REVIEW_DEMO_PHONE=
REVIEW_DEMO_CODE=

# ─── AI listing quality check (docs/listing-quality-ai-review.md) ────
# Reads a new listing's photos + description; a bad device (broken screen,
# dead touch, shattered back, "not working") is held for review and the
# seller is told. Inert until listing_inspection_enabled is switched on in
# the dashboard, and needs the key for the chosen model.
# Default model is OpenAI's GPT-6 Luna (gpt-* → OPENAI_API_KEY).
OPENAI_API_KEY=
# Optional. Any gpt-* or claude-* model; see the cost table in the doc.
# A claude-* model needs ANTHROPIC_API_KEY instead.
LISTING_INSPECT_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
# Optional. Photos are resized to fit this box (long edge x short edge,
# aspect kept, never cropped) before they go to the model. Default 1280x720.
LISTING_INSPECT_IMAGE_MAX=1280x720
# Optional. Fallback photo origin when a file is not on this disk.
PUBLIC_BASE_URL=
